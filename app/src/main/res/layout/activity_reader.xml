<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Zurück"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/gold"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSpeak"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Vorlesen"
            android:gravity="center"
            android:text="🔊"
            android:textSize="22sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnReadSettings"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:contentDescription="Vorlese-Einstellungen"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/gold"
            android:textSize="22sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnOpen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="PDF öffnen"
            android:gravity="center"
            android:text="📂"
            android:textSize="22sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pagepill"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_hell"
            android:textSize="14sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/header_logo" />

                <LinearLayout
                    android:id="@+id/btnOpenBig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_btn_gold"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="66dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📂  PDF öffnen"
                        android:textColor="@color/auf_gold"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Wähle eine PDF-Datei aus – oder tippe in einer anderen App bzw. im Dateimanager auf eine PDF und wähle „PDF-Reader“.\n\nBlättern durch Wischen, Zoomen mit zwei Fingern oder Doppeltippen."
                    android:textColor="@color/text_gedimmt"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="20dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPrivacy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="Datenschutz"
                        android:textColor="@color/gold"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="·"
                        android:textColor="@color/gold"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvImprint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="Impressum"
                        android:textColor="@color/gold"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="·"
                        android:textColor="@color/gold"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvAdSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="Werbe-Einstellungen"
                        android:textColor="@color/gold"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAbout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Eine Idee von autoknigge.de"
                    android:textColor="@color/gold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="4dp"
                    android:textColor="@color/text_gedimmt"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/readBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_box_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvReadStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vorlesen …"
            android:textColor="@color/text_hell"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Pause"
            android:gravity="center"
            android:text="⏸"
            android:textColor="@color/gold"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/btnStopRead"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Vorlesen beenden"
            android:gravity="center"
            android:text="⏹"
            android:textColor="@color/gold"
            android:textSize="22sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ad"
        android:minHeight="60dp" />
</LinearLayout>
